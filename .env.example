# 홈페이지가 공연 정보를 어디서 읽을지
#   files    : content/ 폴더 JSON — Decap CMS(/cms)로 관리 (기본값)
#   supabase : Supabase DB — 관리자 페이지(/admin)로 관리
CONTENT_SOURCE=files

# [A] Supabase — /admin 을 쓰려면 필요 (Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# [B] Decap CMS GitHub 로그인 — 배포 사이트의 /cms 를 쓰려면 필요 (GitHub OAuth App)
DECAP_GITHUB_CLIENT_ID=
DECAP_GITHUB_CLIENT_SECRET=
